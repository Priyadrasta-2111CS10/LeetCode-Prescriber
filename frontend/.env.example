# Copy this file to .env.local (git-ignored) and adjust as needed.

# Set to "false" once your Spring Boot backend is running and reachable,
# to switch from bundled mock data to live API calls.
VITE_USE_MOCK_DATA=true

# Only needed if the frontend is hosted on a different origin than the
# Spring Boot API (e.g. frontend on Vercel, API on a separate host).
# If the frontend is served BY Spring Boot itself, or you're using the
# Vite dev proxy (see vite.config.js), leave this blank.
VITE_API_BASE_URL=

# Placeholder until real auth/session state picks the logged-in user.
VITE_DEFAULT_USERNAME=Priyadrasta_Raut
